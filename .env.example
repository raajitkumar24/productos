PRODUCTOS_ENVIRONMENT=development
PRODUCTOS_DATABASE_URL=postgresql+asyncpg://productos:productos@localhost:5432/productos
PRODUCTOS_DATABASE_AUTO_CREATE=false
PRODUCTOS_MODEL_PROVIDER=development
# For production: openai_compatible. The base URL should include the provider API version,
# for example https://api.example.com/v1. Inject keys through a secret manager.
PRODUCTOS_MODEL_BASE_URL=
PRODUCTOS_MODEL_API_KEY=
PRODUCTOS_MODEL_NAME=
PRODUCTOS_MODEL_TIMEOUT_SECONDS=60
PRODUCTOS_MODEL_MAX_OUTPUT_TOKENS=4096
PRODUCTOS_MODEL_TEMPERATURE=0.1
# Use a separate evaluator model/provider where possible.
PRODUCTOS_JUDGE_BASE_URL=
PRODUCTOS_JUDGE_API_KEY=
PRODUCTOS_JUDGE_MODEL=
PRODUCTOS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PRODUCTOS_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
PRODUCTOS_DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000010
PRODUCTOS_EMBEDDING_PROVIDER=deterministic
PRODUCTOS_EMBEDDING_BASE_URL=
PRODUCTOS_EMBEDDING_API_KEY=
PRODUCTOS_EMBEDDING_MODEL=
PRODUCTOS_EMBEDDING_DIMENSION=128
PRODUCTOS_KNOWLEDGE_CHUNK_TOKENS=500
PRODUCTOS_KNOWLEDGE_CHUNK_OVERLAP_TOKENS=60
PRODUCTOS_RETRIEVAL_LIMIT=8
PRODUCTOS_TOOL_CONTRACT_VERSION=1.0.0
PRODUCTOS_MCP_ADAPTER_VERSION=1.0.0
PRODUCTOS_MAX_TOOL_CALLS=8
PRODUCTOS_MAX_TOOL_ITERATIONS=3
PRODUCTOS_MAX_TOOL_RETRIES=1
PRODUCTOS_MAX_TOOL_LATENCY_SECONDS=20
PRODUCTOS_ATLASSIAN_READ_ENABLED=false
# Streamable HTTP MCP endpoint. Authentication should be handled by an approved gateway/sidecar.
PRODUCTOS_ATLASSIAN_MCP_URL=
# JSON map from ProductOS tool names to provider MCP tool names, if they differ.
PRODUCTOS_ATLASSIAN_MCP_TOOL_MAP={}
PRODUCTOS_AUTH_ENABLED=false
PRODUCTOS_OIDC_ISSUER=
PRODUCTOS_OIDC_AUDIENCE=productos-api
PRODUCTOS_OIDC_JWKS_URL=
PRODUCTOS_OIDC_USER_CLAIM=productos_user_id
PRODUCTOS_OIDC_TENANT_CLAIM=productos_tenant_id
PRODUCTOS_EVALUATION_METRICS_VERSION=1.0.0
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.js reads these at build time. For local frontend overrides, copy
# apps/web/.env.example to apps/web/.env.local instead of relying on this root file.
NEXT_PUBLIC_PRODUCTOS_USER_ID=00000000-0000-4000-8000-000000000001
NEXT_PUBLIC_PRODUCTOS_TENANT_ID=00000000-0000-4000-8000-000000000010
NEXT_PUBLIC_PRODUCTOS_AUTH_ENABLED=false
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_SCOPE="openid profile productos:api"
